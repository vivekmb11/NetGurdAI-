# ---------------------------------------------------------------------------
# Deep Learning-Based Web Attack Detection & Early Warning System
# Example environment configuration -- copy to .env and adjust as needed.
# ---------------------------------------------------------------------------

# Flask Application Settings
SECRET_KEY=change-me-to-a-random-secret-value-in-production
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# SQLite Database Path (defaults to database/app.db inside project root)
DATABASE_URL=sqlite:///database/app.db

# Traffic and Dataset Directories
DATA_DIR=data/raw
PROCESSED_DIR=data/processed
TEST_DIR=data/test
MODELS_DIR=models

# TensorFlow Logging Verbosity (0=all, 1=info, 2=warning, 3=error)
TF_CPP_MIN_LOG_LEVEL=2
TF_ENABLE_ONEDNN_OPTS=0
